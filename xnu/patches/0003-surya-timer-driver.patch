diff --git a/osfmk/arm/arm_timer.c b/osfmk/arm/arm_timer.c
--- a/osfmk/arm/arm_timer.c
+++ b/osfmk/arm/arm_timer.c
@@ -100,6 +100,50 @@ arm_timer_init(void)
 	}
 }
 
+#if defined(SURYA)
+/*
+ * SURYA ARMv7 Timer Driver
+ * 
+ * Surya uses ARMv7 timer memory-mapped at 0x0b020000 with frames:
+ * Frame 0 (0xb021000): Secure physical timer - PPI 8
+ * Frame 1 (0xb022000): Non-secure physical timer - PPI 9  
+ * Frame 2 (0xb023000): Hyp physical timer - PPI 10 (disabled)
+ * Frame 3 (0xb024000): Virtual timer - PPI 11 (INTID 27) <- we use this
+ * 
+ * Each frame has: CTL (0x0), VAL (0x4), CVL (0x8), CVU (0xc)
+ * We use the system generic timer registers (CNTV_*) via system registers
+ * but also need the memory-mapped frame for initialization.
+ */
+#include <arm/arm_timer.h>
+#include <arm/machine_cpu.h>
+#include <kern/kalloc.h>
+#include <pexpert/pexpert.h>
+
+static volatile uint32_t *surya_timer_base = NULL;
+
+void
+surya_timer_init(void)
+{
+	/* Map the ARMv7 timer frame (virtual timer at frame 3 = offset 0x4000) */
+	/* DTB shows timer@b020000 with frames at b021000, b023000, b024000, b025000, b026000, b027000, b028000 */
+	/* Frame 3 (virtual timer) is at 0xb024000 */
+	surya_timer_base = (volatile uint32_t *)phystokv(0x0b024000);
+	
+	if (surya_timer_base) {
+		/* Disable timer initially */
+		surya_timer_base[0] = 0; /* CTL = 0 */
+		kprintf("SURYA: ARMv7 timer mapped at %p\n", surya_timer_base);
+	}
+}
+
+uint64_t
+surya_timer_read_cntvct(void)
+{
+	/* Read virtual timer count from system register (preferred) */
+	return __builtin_arm_rsr64("CNTVCT_EL0");
+}
+
+void
+surya_timer_set_next_event(uint64_t delta_ns)
+{
+	uint64_t freq = 19200000; /* 19.2 MHz from DTB */
+	uint64_t ticks = (delta_ns * freq) / 1000000000ULL;
+	
+	/* Set via system register */
+	__builtin_arm_wsr64("CNTV_TVAL_EL0", (uint32_t)ticks);
+	__builtin_arm_wsr64("CNTV_CTL_EL0", 1); /* Enable */
+	__builtin_arm_isb(ISB_SY);
+}
+
+void
+surya_timer_cancel(void)
+{
+	__builtin_arm_wsr64("CNTV_CTL_EL0", 0); /* Disable */
+	__builtin_arm_isb(ISB_SY);
+}
+#endif /* SURYA */
+
 #if defined(CONFIG_BCM2837)
 /* BCM2837 timer implementation... */
 #endif
