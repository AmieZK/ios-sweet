diff --git a/osfmk/arm/pe_spmi.c b/osfmk/arm/pe_spmi.c
new file mode 100644
--- /dev/null
+++ b/osfmk/arm/pe_spmi.c
@@ -0,0 +1,150 @@
+/*
+ * SPMI (System Power Management Interface) support for Qualcomm platforms
+ * Used by PM8916 PMIC on surya
+ */
+#include <arm/pe_spmi.h>
+#include <arm/machine_cpu.h>
+#include <pexpert/pexpert.h>
+#include <kern/kalloc.h>
+
+static vm_offset_t spmi_base = 0;
+static int spmi_initialized = 0;
+
+void
+pe_spmi_init(void)
+{
+	if (spmi_initialized)
+		return;
+	
+	/* Map SPMI controller registers */
+	/* DTB: spmi@200f000 with reg = <0x0200f000 0x1000 0x02400000 0x40000 0x02c00000 0x4000 0x03800000 0x2000 0x0200a000 0x2100> */
+	spmi_base = phystokv(0x0200f000);
+	
+	if (spmi_base) {
+		spmi_initialized = 1;
+		kprintf("SURYA SPMI: controller mapped at %p\n", (void *)spmi_base);
+	}
+}
+
+vm_offset_t
+pe_spmi_get_base(void)
+{
+	return spmi_base;
+}
+
+int
+pe_spmi_read(uint8_t sid, uint16_t addr, uint8_t *val)
+{
+	if (!spmi_initialized)
+		return ENXIO;
+	
+	volatile uint32_t *chnl = (volatile uint32_t *)(spmi_base + 0x1000); /* Channel 0 */
+	
+	uint32_t cmd = 0x01 | (sid << 4) | ((addr >> 8) & 0x7) << 8 | (addr & 0xff) << 16;
+	chnl[0] = cmd;  /* CMD */
+	chnl[1] = 1;    /* LEN */
+	chnl[2] = 1;    /* TRIGGER */
+	
+	/* Wait for completion */
+	for (int i = 0; i < 10000; i++) {
+		if (chnl[3] & 0x1) break; /* STATUS */
+		DELAY(10);
+	}
+	
+	*val = chnl[4] & 0xff; /* DATA */
+	return 0;
+}
+
+int
+pe_spmi_write(uint8_t sid, uint16_t addr, uint8_t val)
+{
+	if (!spmi_initialized)
+		return ENXIO;
+	
+	volatile uint32_t *chnl = (volatile uint32_t *)(spmi_base + 0x1000);
+	
+	uint32_t cmd = 0x02 | (sid << 4) | ((addr >> 8) & 0x7) << 8 | (addr & 0xff) << 16;
+	chnl[0] = cmd;  /* CMD */
+	chnl[1] = 1;    /* LEN */
+	chnl[5] = val;  /* DATA */
+	chnl[2] = 1;    /* TRIGGER */
+	
+	for (int i = 0; i < 10000; i++) {
+		if (chnl[3] & 0x1) break;
+		DELAY(10);
+	}
+	return 0;
+}
+
+int
+pe_spmi_configure_channel(uint8_t channel, uint8_t sid)
+{
+	if (!spmi_initialized)
+		return ENXIO;
+	
+	volatile uint32_t *cnfg = (volatile uint32_t *)(spmi_base + 0x1000 + 0x4000 + 0x4000); /* CNGF */
+	cnfg[channel] = sid;
+	return 0;
+}
